# Copy this file to ".env" (in the same folder as manage.py) and edit
# as needed. backend/settings.py reads it automatically — no extra
# package required. Anything left unset falls back to a safe default
# for local development.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*
COLLEGE_EMAIL_DOMAIN=@yourcollege.edu
